# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# ===== 静态检查 / 测试缓存 =====
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ===== 虚拟环境 =====
.venv/
venv/
env/

# ===== 模型权重（统一由 auto2dlabel/weights/download_weights.sh 下载，不入库）=====
auto2dlabel/weights/
auto3dlabel/weights/
*.pt
*.pth
*.onnx
*.safetensors

# ===== 生成产物 =====
outputs/
vis_outputs/
benchmarks_outputs/
logs/

# ===== 图像/视频 =====
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff
*.mp4
*.avi
*.mov
# 例外：测试夹具必须入库（pytest 依赖 tests/data 的样例图）
!auto2dlabel/tests/data/*

# ===== 配置（含 API Key，严禁入库；提交 .env.example 作为模板）=====
auto2dlabel/configs/.env

# ===== 本地数据集（benchmark 用，路径见 benchmarks/datasets.py）=====
/datasets/
/data/

# ===== IDE / 编辑器 =====
.vscode/
.idea/
*.swp

# ===== OS =====
.DS_Store
Thumbs.db

# ===== Claude Code 会话数据（个人会话，不入库）=====
.claude/

