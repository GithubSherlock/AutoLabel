# AutoLabel 2D 环境变量模板——复制为同目录 .env 并填入真实值（.env 严禁入库）。
# LLM provider 连接配置见 providers.yaml（api_key_env 只引用这里的变量名）。

# DeepSeek API（项目唯一外部依赖；可改本地 Ollama/vLLM 端点，见 providers.yaml ollama 条目）
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 默认检测模型 env 覆盖（默认 yolo26x.pt，单一事实源 schema/task_plan.DEFAULT_MODEL）
DETECTION_MODEL=
